{
  "autostart": true,
  "binary": {
    "linux": {
      "aarch64": "target/release/kick-adapter-rs",
      "arm": "target/release/kick-adapter-rs",
      "x86_64": "target/release/kick-adapter-rs"
    },
    "macos": {
      "aarch64": "target/release/kick-adapter-rs",
      "arm": "target/release/kick-adapter-rs",
      "x86_64": "target/release/kick-adapter-rs"
    },
    "windows": {
      "aarch64": "target/release/kick-adapter-rs.exe",
      "arm": "target/release/kick-adapter-rs.exe",
      "x86_64": "target/release/kick-adapter-rs.exe"
    }
  },
  "build_command": "cargo",
  "build_flags": [
    "build",
    "--release"
  ],
  "capabilities": "input",
  "command_flags": [
    "--release"
  ],
  "credentials": [
    {
      "env": "",
      "key": "channel_name",
      "label": "Channel",
      "list": false,
      "sensitive": false
    },
    {
      "env": "KICK_CLIENT_ID",
      "key": "client_id",
      "label": "Client ID (kick.com/settings/developer)",
      "list": false,
      "sensitive": true
    },
    {
      "env": "KICK_CLIENT_SECRET",
      "key": "client_secret",
      "label": "Client Secret",
      "list": false,
      "sensitive": true
    },
    {
      "env": "KICK_OAUTH_TOKEN",
      "key": "oauth_token",
      "label": "OAuth Token (auto-acquired)",
      "list": false,
      "optional": true,
      "sensitive": true
    }
  ],
  "description": "a module to interface with kick.com",
  "launch_command": "cargo run",
  "name": "kick-adapter",
  "root_file": "./src/main.rs",
  "version": "0.1.0",
  "price": 0,
  "min_rank": 0,
  "authority": 0
}